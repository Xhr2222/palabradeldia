rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function inicio(tipo, periodo) {
      let p = periodo.split('-');
      return tipo == 'semana'
        ? timestamp.date(int(p[0]), int(p[1]), int(p[2]))
        : timestamp.date(int(p[0]), int(p[1]), 1);
    }

    function fin(tipo, periodo) {
      let p = periodo.split('-');
      let y = int(p[0]);
      let m = int(p[1]);
      return tipo == 'semana'
        ? inicio(tipo, periodo) + duration.value(7, 'd')
        : (m == 12 ? timestamp.date(y + 1, 1, 1) : timestamp.date(y, m + 1, 1));
    }

    function esVotoValido(id, v) {
      return v.keys().hasOnly(['tipo', 'periodo', 'usuario', 'palabra', 'fecha'])
        && v.keys().hasAll(['tipo', 'periodo', 'usuario', 'palabra', 'fecha'])
        && v.periodo is string
        && ((v.tipo == 'semana' && v.periodo.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          || (v.tipo == 'mes' && v.periodo.matches('[0-9]{4}-[0-9]{2}')))
        && v.usuario is string && v.usuario.size() > 0 && v.usuario.size() <= 40
        && v.palabra is string && v.palabra.size() > 0 && v.palabra.size() <= 60
        && v.fecha == request.time
        && id == v.tipo + '_' + v.periodo + '_' + v.usuario
        && request.time >= inicio(v.tipo, v.periodo)
        && request.time < fin(v.tipo, v.periodo);
    }

    match /votos/{voto} {
      allow read: if true;
      allow create, update: if esVotoValido(voto, request.resource.data);
    }
  }
}
